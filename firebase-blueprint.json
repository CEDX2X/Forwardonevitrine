        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "authorRole": { "type": "string" },
        "date": { "type": "string" },
        "readTime": { "type": "string" },
        "image": { "type": "string" },
        "published": { "type": "boolean" },
        "views": { "type": "number" }

{
  "entities": {
    "siteContent": {
      "title": "Site Content",
      "description": "Global text content and contact information for Forward One",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroSlogan": { "type": "string" },
        "aboutHeadline": { "type": "string" },
        "aboutStory": { "type": "string" },
        "aboutArrowMeaning": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactAddress": { "type": "string" }
      }
    },
    "services": {
      "title": "Service Item",
      "description": "Marketing digital and logistique événementielle services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "shortDescription": { "type": "string" },
        "fullDescription": { "type": "string" },
        "iconName": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "image": { "type": "string" }
      },
      "required": ["id", "title", "category"]
    },
    "products": {
      "title": "Product Item",
      "description": "Equipment and material catalog for rental",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "dailyRate": { "type": "number" },
        "stockQuantity": { "type": "number" },

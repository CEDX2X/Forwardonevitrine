        "endDate": { "type": "string" },
        "durationDays": { "type": "number" },
        "totalEstimate": { "type": "number" },
        "location": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "clientName", "email", "phone"]

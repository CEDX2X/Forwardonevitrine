      "required": ["id", "title", "module"]
    },
    "articles": {
      "title": "Article Item",
      "description": "Blog posts and news articles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },

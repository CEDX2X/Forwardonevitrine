        "image": { "type": "string" },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "dailyRate"]
    },
    "packs": {
      "title": "Pack Item",
      "description": "Turnkey offers and bundled packages",
      "type": "object",
      "properties": {
